rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cek: yang login adalah pemilik data ini?
    function pemilik(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Cek: isi tugas valid?
    function tugasValid(d) {
      return d.judul is string && d.judul.size() > 0 && d.judul.size() <= 100
          && d.prioritas in ['rendah', 'sedang', 'tinggi']
          && d.kategori in ['Sekolah', 'Pribadi', 'Kerja', 'Lainnya']
          && d.selesai is bool;
    }

    // Profil user: users/{userId}
    match /users/{userId} {
      allow read, write: if pemilik(userId);

      // Tugas milik user: users/{userId}/tasks/{taskId}
      match /tasks/{taskId} {
        allow read, delete: if pemilik(userId);
        allow create, update: if pemilik(userId) && tugasValid(request.resource.data);
      }
    }
  }
}
